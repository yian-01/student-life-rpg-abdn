SYNC_DOMAIN=sync.example.com
# Public registration by default. Set a non-empty value only for invite-only deployments.
SYNC_SIGNUP_CODE=
# Comma-separated trusted frontend origins; leave empty for same-origin only.
# Native clients authenticate with Bearer tokens and do not require a frontend origin.
SYNC_ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com
